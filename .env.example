# ==============================================================================
# Segments Manager - Environment Configuration (MongoDB Backend)
# ==============================================================================

# ------------------------------------------------------------------------------
# MongoDB Connection (Required)
# ------------------------------------------------------------------------------
# MongoDB connection URL
# Local:  mongodb://localhost:27017
# Auth:   mongodb://user:password@host:27017
# Atlas:  mongodb+srv://user:password@cluster.mongodb.net
MONGODB_URL=mongodb://localhost:27017

# MongoDB database name (optional, default: segments-manager)
MONGODB_DB_NAME=segments-manager

# Collection holding the segments (optional, default: segments)
MONGODB_COLLECTION=segments

# ------------------------------------------------------------------------------
# Site Configuration (Required)
# ------------------------------------------------------------------------------
# Site network topology — the single source of truth for configured sites.
# SITES is derived from its keys, so the two can never drift apart.
#
#   pool  the CIDR every segment at that site must fall INSIDE (checked on
#         every create). site1 below accepts 192.10.x.x and nothing else.
#   pool-exceptions  OPTIONAL list of CIDRs accepted at that site even though
#         they are OUTSIDE `pool` — e.g. {"pool-exceptions": ["172.20.4.0/22"]}.
#         The escape hatch for a legacy network: adding one entry beats widening
#         the pool, which would loosen the rule for every future segment. Match
#         is EXACT — listing a /22 permits that /22, not the /24s inside it —
#         and it bypasses the containment check only; mask, reserved-range and
#         overlap checks still apply. Startup rejects an entry that overlaps any
#         pool or another entry.
#
# Sub-keys this service does not recognise are ignored — another consumer may
# own them. Under Helm/Argo CD this comes from the chart's `siteNetworks` value,
# which becomes this env var in the ConfigMap.
SITE_NETWORKS={"site1": {"pool": "192.10.0.0/16"}, "site2": {"pool": "193.51.0.0/16"}, "site3": {"pool": "194.52.0.0/16"}}

# ------------------------------------------------------------------------------
# Server Configuration (Optional)
# ------------------------------------------------------------------------------
# Bind address, log level and log file path are constants in the code, not env
# vars: the app always binds 0.0.0.0, logs at INFO, and writes its rotating log
# to <app root>/data/segments_manager.log.
SERVER_PORT=8000

# ------------------------------------------------------------------------------
# Authentication
# ------------------------------------------------------------------------------
# API token — REQUIRED (the app fails to start without it). It is the ONLY
# credential: there is no username/password login. Every mutating API call
# (POST/PUT/PATCH/DELETE) must send it as: Authorization: Bearer <API_TOKEN>
# GET requests stay open (the read-only web UI needs no auth). Use a long random
# secret, e.g.  API_TOKEN="$(openssl rand -hex 32)"
API_TOKEN=

# (No WORKFLOWS_API_URL: this service calls nothing. The orchestrator's
# initialize-segment workflow is triggered directly by its caller and calls
# POST /api/segments here itself, so segment creation lives inside one durable
# Temporal run instead of starting outside it.)
