# MongoDB Configuration for Air-Gapped Environment
MONGODB_URL=mongodb://username:password@your-mongo-host:27017/segments_manager?authSource=admin
DATABASE_NAME=segments_manager

# Site Configuration — SITES is NOT an env var; it is derived from the keys of
# SITE_NETWORKS below.
SITE_NETWORKS={"site1": {"pool": "192.10.0.0/16", "bmc": "10.50.0.0/16"}, "site2": {"pool": "193.51.0.0/16", "bmc": "10.51.0.0/16"}, "site3": {"pool": "194.52.0.0/16", "bmc": "10.52.0.0/16"}}

# Optional: MongoDB credentials if using separate variables
MONGO_USERNAME=your_username
MONGO_PASSWORD=your_password
MONGO_HOST=your-mongo-host
MONGO_PORT=27017
MONGO_AUTH_DB=admin