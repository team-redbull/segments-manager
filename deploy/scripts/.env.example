# MongoDB Configuration for Air-Gapped Environment
MONGODB_URL=mongodb://username:password@your-mongo-host:27017/segments-manager?authSource=admin
DATABASE_NAME=segments-manager

# Site Configuration — SITES is NOT an env var; it is derived from the keys of
# SITE_NETWORKS below. A site may also carry an optional "pool-exceptions" list
# of CIDRs accepted despite being outside its pool (exact CIDR match) — the
# escape hatch for a legacy network, instead of widening the pool.
SITE_NETWORKS={"site1": {"pool": "192.10.0.0/16", "dell-bmc": "10.50.0.0/16", "cisco-bmc": "10.60.0.0/16"}, "site2": {"pool": "193.51.0.0/16", "dell-bmc": "10.51.0.0/16", "cisco-bmc": "10.61.0.0/16"}, "site3": {"pool": "194.52.0.0/16", "dell-bmc": "10.52.0.0/16", "cisco-bmc": "10.62.0.0/16"}}

# Optional: MongoDB credentials if using separate variables
MONGO_USERNAME=your_username
MONGO_PASSWORD=your_password
MONGO_HOST=your-mongo-host
MONGO_PORT=27017
MONGO_AUTH_DB=admin